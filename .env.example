# Put your real .env in this folder OR in the folder above it. Never commit it.
# One of these two is required for live lessons; without either, the app offers the bundled sample lesson.

# Course key (Portkey gateway). Used first if present. Model: gpt-6-luna.
PORTKEY_API_KEY=

# Personal OpenAI key. Used only if PORTKEY_API_KEY is empty.
OPENAI_API_KEY=

# Optional, non-secret settings
# DAILY_SIGNAL_MODEL=gpt-6-luna
# DAILY_SIGNAL_MODE=demo            # force sample-lesson mode (no model calls)
# DAILY_SIGNAL_MAX_RUNS_PER_DAY=40  # server-wide cap on lesson generations
